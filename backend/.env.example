# WAY Backend Configuration
DEBUG=False
SECRET_KEY=change-me-in-production-way-2024-secure-key
DATABASE_URL=postgresql://way:way@postgres:5432/way_db
REDIS_URL=redis://redis:6379/0

# Security
JWT_SECRET=way-jwt-secret-2024
JWT_ACCESS_LIFETIME=900
JWT_REFRESH_LIFETIME=604800
ENCRYPTION_KEY=way-encryption-key-32bytes-long

# Rate Limiting
RATE_LIMIT=50
RATE_LIMIT_WINDOW=60

# Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
GROK_API_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MPESA_API_KEY=
MPESA_SECRET=

# Storage
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO

# Currency
DEFAULT_CURRENCY=USD
CREDIT_RATE=100

# Features
ENABLE_WEBSOCKET=True
ENABLE_CELERY=True
